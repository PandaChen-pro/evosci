# Copy to web/.env and load it before starting the service (e.g. `set -a; . web/.env; set +a`).
# The API key is read from the environment only — never put it in a TOML or a request body.

# The one secret. Its NAME is what a run's config carries; its VALUE stays in this process.
PRISMLLM_API_KEY=

# Leave unset to have a fresh token generated and printed at startup.
# If you do set it, it must be at least 24 characters.
EVOSCI_WEB_TOKEN=

# Where runs submitted through the UI are written.
EVOSCI_RUNS_ROOT=runs

# Extra read-only directories to list past runs from, separated by ':'.
# A run found here is never resumed in place — the UI shows it as archived.
EVOSCI_SCAN_ROOTS=results

# 0.0.0.0 exposes the service to the LAN and requires a token of 24+ characters.
EVOSCI_WEB_HOST=127.0.0.1
EVOSCI_WEB_PORT=8000

# One run at a time, which is also the API-spend gate. Server-side ceiling on run.rounds.
EVOSCI_MAX_CONCURRENT=1
EVOSCI_MAX_ROUNDS=10
